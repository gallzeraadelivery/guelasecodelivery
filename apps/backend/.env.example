# --- Usadas a partir da Fase 1 ---
NODE_ENV=development
PORT=3333
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Fase 5 (pagamentos/split Mercado Pago) ---
# URL pública deste backend (usada para montar redirect_uri do OAuth e a
# notification_url do webhook). Em produção: a URL real do backend hospedado.
BACKEND_PUBLIC_URL=
# Application ID/Secret de uma aplicação Mercado Pago do tipo "Marketplace"
# (Mercado Pago Developers > Suas integrações > Criar aplicação). Use as
# credenciais de TESTE (gratuitas) até estar pronto para produção.
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
# Gerado ao configurar o webhook desta aplicação no painel do Mercado Pago
# apontando para {BACKEND_PUBLIC_URL}/webhooks/mercadopago.
MERCADOPAGO_WEBHOOK_SECRET=

# --- Fase 4/8 (mapas/roteirização) ---
MAPBOX_ACCESS_TOKEN=

# --- Fase 6 (KYC do entregador) ---
KYC_PROVIDER=bitcoinp2p
BITCOINP2P_API_KEY=

# --- Push notifications ---
EXPO_ACCESS_TOKEN=
EXPO_PROJECT_ID=

{
  "expo": {
    "name": "GUELA SECO",
    "slug": "guela-seco-cliente",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "guelaseco",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.guelaseco.cliente"
    },
    "android": {
      "package": "br.com.guelaseco.cliente",
      "adaptiveIcon": {
        "backgroundColor": "#E5252A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O GUELA SECO usa sua localização para encontrar distribuidoras próximas e calcular o tempo de entrega."
        }
      ]
    ],
    "owner": "gallzeraaoficials-team",
    "extra": {
      "eas": {
        "projectId": "c61012c9-5774-4416-b75b-003e96636490"
      }
    }
  }
}

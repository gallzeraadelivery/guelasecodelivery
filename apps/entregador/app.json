{
  "expo": {
    "name": "Guela Seco Driver",
    "slug": "guela-seco-entregador",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "guelasecoentregador",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.guelaseco.entregador"
    },
    "android": {
      "package": "br.com.guelaseco.entregador",
      "adaptiveIcon": {
        "backgroundColor": "#FFD400",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O GUELA SECO Entregador usa sua localização para te oferecer corridas próximas e acompanhar a entrega."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5fd7508e-4420-464e-a9cd-ef7f1af8d4e5"
      }
    },
    "owner": "gallzeraaoficials-team"
  }
}
